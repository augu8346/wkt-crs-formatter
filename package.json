{
  "name": "wkt-crs-formatter",
  "displayName": "WKT CRS Formatter",
  "description": "Format WKT1 and WKT2 coordinate reference systems, including JSON-escaped definitions.",
  "version": "0.2.0",
  "publisher": "local-preview",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/augu8346/wkt-crs-formatter.git"
  },
  "bugs": "https://github.com/augu8346/wkt-crs-formatter/issues",
  "homepage": "https://github.com/augu8346/wkt-crs-formatter#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Formatters",
    "Programming Languages"
  ],
  "keywords": [
    "wkt",
    "wkt1",
    "wkt2",
    "crs",
    "projection"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:wkt-crs"
  ],
  "contributes": {
    "languages": [
      {
        "id": "wkt-crs",
        "aliases": [
          "WKT (Coordinate Reference System)",
          "wkt-crs"
        ],
        "extensions": [
          ".wkt",
          ".wkt1",
          ".wkt2",
          ".prj"
        ]
      }
    ],
    "grammars": [
      {
        "language": "wkt-crs",
        "scopeName": "source.wkt-crs",
        "path": "./syntaxes/wkt-crs.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "wkt-crs.format",
        "title": "WKT: Format Coordinate Reference System"
      }
    ]
  },
  "files": [
    "extension.js",
    "formatter.js",
    "syntaxes",
    "README.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/formatter.test.js",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@vscode/vsce": "4.1.1"
  }
}
